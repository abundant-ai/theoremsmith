# Task creation (the scanner, theorem selection, and the task description) runs on the create model,
# through one OpenAI-compatible endpoint.
THEOREMSMITH_API_KEY=
THEOREMSMITH_BASE_URL=https://openrouter.ai/api/v1
THEOREMSMITH_CREATE_MODEL=moonshotai/kimi-k2.7-code
THEOREMSMITH_MAX_RUNS=2
THEOREMSMITH_DATA=./data
THEOREMSMITH_BUILD_TIMEOUT=3600
THEOREMSMITH_PROBE_TIMEOUT=900
THEOREMSMITH_CLONE_TIMEOUT=600

# A finished task is run on Oddish (needs the `oddish` CLI installed and signed in) with this agent
# and model, under a time limit, and returns a public link.
THEOREMSMITH_ODDISH_AGENT=claude-code
THEOREMSMITH_ODDISH_MODEL=claude-haiku-4-5
THEOREMSMITH_ODDISH_TIMEOUT=1800
# THEOREMSMITH_ODDISH_ENV=daytona
# Solvers offered in the submit dialog: "Label|model|agent" items, comma-separated
# (agent defaults to claude-code). DeepSeek is not in Oddish's table — override its
# id here (e.g. openrouter/deepseek/...) if the default does not resolve.
# THEOREMSMITH_ODDISH_SOLVERS=Claude Haiku 4.5|claude-haiku-4-5, DeepSeek V4 Flash|deepseek-v4-flash, MiniMax M3|minimax-m3, Claude Code (Sonnet)|claude-sonnet-4-6
